---
import ContactChannels from "../components/ContactChannels.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { SITE_CONTACT, SITE_CTA, SITE_NAME } from "../lib/site";
---

<SiteLayout
  title={`Kontakt — ${SITE_NAME}`}
  description="Skontaktuj się z Wojciechem Zudro — Büroservice. WhatsApp, Messenger lub e-mail — mieszkanie, praca, świadczenia, kredyt, tłumaczenie albo urząd."
>
  <section class="simple-page contact-page">
    <div class="contact-hero">
      <div class="contact-hero-copy">
        <p class="magazine-kicker gold-text">Kontakt</p>
        <h1 class="simple-page-title contact-title">{SITE_CTA.contactTitle}</h1>
        <p class="simple-page-lead contact-lead">
          Opowiedz, w jakiej sprawie potrzebujesz pomocy — mieszkanie, praca, świadczenia, kredyt,
          tłumaczenie albo urząd. Oddzwonię lub odpiszę, żeby ustalić zakres.
        </p>
        <p class="contact-phone">
          Telefon:
          <a class="gold-text" href={`tel:${SITE_CONTACT.phone}`}>{SITE_CONTACT.phoneDisplay}</a>
        </p>
        <p class="contact-email">
          E-mail:
          <a class="gold-text" href={`mailto:${SITE_CONTACT.email}`}>{SITE_CONTACT.email}</a>
        </p>
        <p class="contact-office">
          Adres biura:
          <span class="contact-office-value">{SITE_CONTACT.officeAddress}</span>
        </p>
        <p class="contact-tax">
          Numer podatkowy (Steuernummer):
          <span class="contact-tax-value">{SITE_CONTACT.taxNumber}</span>
        </p>
        <a href={`mailto:${SITE_CONTACT.email}`} class="site-btn site-btn-primary contact-email-btn">
          {SITE_CTA.buttonMenu}
        </a>
      </div>

      <aside class="contact-hero-aside" aria-label="Szybki kontakt i mapa">
        <div class="contact-info-card">
          <p class="contact-info-label gold-text">Najszybciej odpowiadam</p>
          <p class="contact-info-text">Tutaj najszybciej odpowiadam — napisz na WhatsApp, Messengerze albo odwiedź fanpage.</p>
          <ContactChannels />
        </div>

        <div class="contact-map-card">
          <p class="contact-info-label gold-text">Biuro w Bebertalu</p>
          <p class="contact-map-address">{SITE_CONTACT.officeAddress}</p>
          <div class="contact-map-wrap">
            <iframe
              title={`Mapa Google — ${SITE_CONTACT.officeAddress}`}
              src={`https://www.google.com/maps?q=${encodeURIComponent(SITE_CONTACT.officeAddress)}&z=17&t=k&output=embed`}
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              allowfullscreen></iframe>
          </div>
        </div>
      </aside>
    </div>
  </section>
</SiteLayout>
