---
import AboutGallery from "../components/AboutGallery.astro";
import AboutPageMotion from "../components/AboutPageMotion.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { SITE_CTA, SITE_NAME, SITE_TAGLINE, withBase } from "../lib/site";

const aboutPhotos = [
  { src: "/wojtek2.jpg", alt: "Wojciech Zudro — emigracja i języki" },
  { src: "/wojtek1.jpg", alt: "Wojciech Zudro — portret" },
  { src: "/wojtek3.jpg", alt: "Wojciech Zudro — pomoc w urzędach i formalnościach" },
  { src: "/wojtek4.jpg", alt: "Wojciech Zudro — Büroservice w Bebertalu" },
  { src: "/wojtek5.jpg", alt: "Wojciech Zudro — spotkanie i rozmowa" },
  { src: "/wojtek6.jpg", alt: "Wojciech Zudro — zaproszenie do kontaktu" },
] as const;

const aboutBody = [
  "Doskonale wiem, jak to jest wylądować w obcym kraju, trzymając w ręku plik urzędowych pism, które wyglądają jak pisane szyfrem.",
  "Na emigracji jestem od 2010 roku, a od 2018 roku moim miejscem na ziemi są Niemcy. Zanim jednak tutaj osiadłem, zwiedziłem kawałek Europy, zbierając doświadczenia, poznając ludzi i przede wszystkim chłonąc języki – bo to od dawna jedna z moich pasji. Dziś bez problemu dogaduję się po niemiecku, angielsku i niderlandzku, a w wolnych chwilach uczę się języka arabskiego.",
  "Pomaganie rodakom zaczęło się u mnie zupełnie naturalnie. Najpierw była to sąsiedzka przysługa przy szukaniu mieszkania czy garażu, potem wspólne wyprawy do urzędów, żeby oswoić słynną „niemiecką papierologię”, aż wreszcie tłumaczenia u notariuszy, prawników czy na policji. Z czasem z tej pasji i chęci ułatwiania ludziom życia powstała moja oficjalna działalność – Büroservice. Głównie zajmuję się pomocą w znalezieniu mieszkania lub domu na wynajem w Niemczech. Pomogłem już wielu narodowościom, głównie Polakom, lecz zdarzało się pomagać i Ukraińcom, Kurdom, Algierczykom, Marokańczykom, Wietnamczykom, a nawet Niemcom. Jestem niezmiernie z tego rad, iż w naszym pięknym kraju – Niemczech – chce mieszkać tyle narodowości; jest to niewątpliwie siła i plus Niemiec, iż każdy, kto chce pracować, może tu dostać szanse, a ja chętnie pomogę w stawianiu pierwszych kroków – od terminu w urzędzie migracyjnym, meldunkowym, aż po znalezienie swojego pierwszego wymarzonego mieszkania lub domu w Niemczech i rozpoczęcie nowej pracy – w zrobieniu pierwszego kroku ku marzeniom, ku lepszemu jutru.",
  "Załatwiam mieszkania i domy na wynajem zarówno osobom, które są na miejscu w Niemczech, jak i osobom spoza Niemiec. Jest możliwość wynajęcia mieszkania bądź domu w Niemczech w oparciu o przychody z ostatnich 3 miesięcy spoza Niemiec. Ściągałem do Niemiec już rodziny i pary bezpośrednio z Polski, Islandii, Holandii, Belgii czy Norwegii.",
  "Moje biuro mieści się w Bebertalu, około 30 km od Magdeburga, ale problemy moich klientów rozwiązuję na terenie całych Niemiec.",
  "Jeśli masz ochotę sprawdzić, jak to działa w praktyce, wpadnij do mnie na dobrą kawę do biura, zdzwońmy się na kamerce albo po prostu pogadajmy przez telefon. Pierwsza rozmowa jest zawsze całkowicie niezobowiązująca i darmowa. A jeśli akurat nie odbiorę – spokojnie, prawdopodobnie jestem właśnie na terminie lub spotkaniu, ewentualnie nie mam zasięgu, i oddzwonię najszybciej, jak to możliwe!",
] as const;
---

<SiteLayout
  title={`O mnie — ${SITE_NAME}`}
  description="Wojciech Zudro — Büroservice. Emigracja, języki i pomoc w urzędach, mieszkaniach i formalnościach w całych Niemczech — osobiście i bez zbędnego stresu."
>
  <section class="about-editorial">
    <div class="about-editorial-grid">
      <aside class="about-editorial-media" aria-label="Zdjęcia">
        <AboutGallery photos={aboutPhotos} />
      </aside>

      <div class="about-editorial-panel">
        <div class="about-editorial-panel-inner">
          <p class="about-editorial-greeting about-reveal" data-about-reveal="immediate" data-reveal-delay="100">
            Cześć!
          </p>
          <h1
            class="about-editorial-name about-reveal"
            data-about-reveal="immediate"
            data-reveal-delay="200"
          >
            Jestem {SITE_NAME}
          </h1>
          <p
            class="about-editorial-tagline about-reveal"
            data-about-reveal="immediate"
            data-reveal-delay="300"
          >
            {SITE_TAGLINE} — od lat pomagam rodakom w Niemczech.
          </p>

          <div class="about-editorial-body">
            {
              aboutBody.map((paragraph, index) => (
                <p
                  class:list={[
                    "about-editorial-text",
                    "about-reveal",
                    index % 2 === 1 && "about-editorial-text-align-right",
                  ]}
                  data-about-reveal="scroll"
                >
                  {paragraph}
                </p>
              ))
            }
          </div>

          <p class="about-editorial-closer about-reveal" data-about-reveal="scroll">
            Chętnie zdejmę z Twoich barków zbędny stres i doprowadzę sprawę do szczęśliwego finału.
          </p>

          <a
            href={withBase("/kontakt")}
            class="site-btn site-btn-primary about-editorial-cta about-reveal"
            data-about-reveal="scroll"
            data-reveal-delay="100"
          >
            {SITE_CTA.buttonPrimary}
          </a>
        </div>
      </div>
    </div>
  </section>

  <AboutPageMotion />
</SiteLayout>
