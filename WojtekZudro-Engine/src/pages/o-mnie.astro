---
import SiteLayout from "../layouts/SiteLayout.astro";
import { SITE_NAME, SITE_TAGLINE } from "../lib/site";
---

<SiteLayout
  title={`O mnie — ${SITE_NAME}`}
  description="Wojciech Zudro — Büroservice. Sekretariat, dokumentacja i organizacja pracy biura prowadzone osobiście, z dyskrecją i porządkiem."
>
  <section class="simple-page">
    <p class="magazine-kicker gold-text">O mnie</p>
    <h1 class="simple-page-title">{SITE_NAME}</h1>
    <p class="simple-page-lead">
      {SITE_TAGLINE} — osobista obsługa biura: sekretariat, dokumentacja i organizacja pracy.
    </p>
    <p class="simple-page-text">
      Prowadzę sprawy biurowe tak, żebyś mógł zająć się firmą. Korespondencja, dokumenty i terminy
      zostają uporządkowane — dyskretnie i na czas.
    </p>
    <a href="/kontakt" class="site-btn site-btn-primary">Umów rozmowę</a>
  </section>
</SiteLayout>
