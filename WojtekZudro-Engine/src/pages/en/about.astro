---
import AboutGallery from "../../components/AboutGallery.astro";
import AboutPageMotion from "../../components/AboutPageMotion.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getContent, localePath } from "../../i18n";
import { SITE_NAME, SITE_TAGLINE } from "../../lib/site";

const content = getContent("en");
const { aboutBody, aboutPhotoAlts, labels, SITE_CTA } = content;

const photoSources = [
  "/wojtek2.jpg",
  "/wojtek1.jpg",
  "/wojtek3.jpg",
  "/wojtek4.jpg",
  "/wojtek5.jpg",
  "/wojtek6.jpg",
] as const;

const photos = photoSources.map((src, index) => ({ src, alt: aboutPhotoAlts[index]! }));
---

<SiteLayout
  title={`About — ${SITE_NAME}`}
  description="Wojciech Zudro — Büroservice. Emigration, languages, and help with authorities, housing, and formalities across Germany."
>
  <section class="about-editorial">
    <div class="about-editorial-grid">
      <aside class="about-editorial-media" aria-label="Photos">
        <AboutGallery photos={photos} galleryAriaLabel={labels.galleryAria} />
      </aside>

      <div class="about-editorial-panel">
        <div class="about-editorial-panel-inner">
          <p class="about-editorial-greeting about-reveal" data-about-reveal="immediate" data-reveal-delay="100">
            {labels.aboutGreeting}
          </p>
          <h1 class="about-editorial-name about-reveal" data-about-reveal="immediate" data-reveal-delay="200">
            I am {SITE_NAME}
          </h1>
          <p class="about-editorial-tagline about-reveal" data-about-reveal="immediate" data-reveal-delay="300">
            {SITE_TAGLINE} {labels.aboutTaglineSuffix}
          </p>

          <div class="about-editorial-body">
            {
              aboutBody.map((paragraph, index) => (
                <p
                  class:list={[
                    "about-editorial-text",
                    "about-reveal",
                    index % 2 === 1 && "about-editorial-text-align-right",
                  ]}
                  data-about-reveal="scroll"
                >
                  {paragraph}
                </p>
              ))
            }
          </div>

          <p class="about-editorial-closer about-reveal" data-about-reveal="scroll">
            {labels.aboutCloser}
          </p>

          <a
            href={localePath("en", "contact")}
            class="site-btn site-btn-primary about-editorial-cta about-reveal"
            data-about-reveal="scroll"
            data-reveal-delay="100"
          >
            {SITE_CTA.buttonPrimary}
          </a>
        </div>
      </div>
    </div>
  </section>

  <AboutPageMotion />
</SiteLayout>
