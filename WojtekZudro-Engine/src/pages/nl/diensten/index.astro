---
import SiteLayout from "../../../layouts/SiteLayout.astro";
import { getContent, serviceUrl } from "../../../i18n";
import { SITE_NAME } from "../../../lib/site";

const content = getContent("nl");
const { SITE_SERVICES, labels } = content;
---

<SiteLayout
  locale="nl"
  title={`Diensten — ${SITE_NAME}`}
  description="Huisvesting, werk, uitkeringen, leningen, tolken en instanties — Wojciech Zudro Büroservice."
>
  <section class="simple-page">
    <p class="magazine-kicker gold-text">{labels.servicesKicker}</p>
    <h1 class="simple-page-title">{labels.servicesTitle}</h1>
    <p class="simple-page-lead">{labels.servicesLead}</p>
  </section>
  <div class="magazine-card-grid magazine-card-grid-3">
    {
      SITE_SERVICES.map((service) => (
        <a class="magazine-card" href={serviceUrl("nl", service.slug)}>
          <p class="magazine-card-tag gold-text">{service.tag}</p>
          <h2 class="magazine-card-title">{service.title}</h2>
          <p class="magazine-card-text">{service.description}</p>
          <span class="magazine-card-more">{labels.cardReadMore}</span>
        </a>
      ))
    }
  </div>
</SiteLayout>
