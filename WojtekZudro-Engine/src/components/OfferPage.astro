---
import type { OfferData } from "../../data/offers/types";
import ContactChannels from "./ContactChannels.astro";

interface Props {
  offer: OfferData;
}

const { offer } = Astro.props;
const pageCanonical = `${Astro.site?.toString().replace(/\/$/, "") ?? "https://boostilia.pl"}/oferta/${offer.slug}`;
---

<Fragment>
  <section class="offer-hero">
    <p class="home-eyebrow gold-text">{offer.tag}</p>
    <h1 class="offer-title">{offer.title}</h1>
    <p class="offer-lead">{offer.heroLead}</p>
    <div class="home-hero-actions">
      <a href="/kontakt" class="site-btn site-btn-primary">Bezpłatna konsultacja</a>
    </div>
  </section>

  <section class="offer-section" aria-labelledby="offer-scope-title">
    <h2 id="offer-scope-title" class="offer-section-title">{offer.scopeTitle}</h2>
    <p class="offer-section-intro">{offer.scopeIntro}</p>
    <div class="offer-grid">
      {
        offer.scope.map((item) => (
          <article class="offer-card">
            <h3 class="offer-card-title">{item.title}</h3>
            <p class="offer-card-text">{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="offer-split">
    <div class="offer-split-block offer-split-for-who">
      <h2 class="offer-section-title">{offer.forWhoTitle}</h2>
      <ul class="offer-list">
        {offer.forWho.map((item) => <li>{item}</li>)}
      </ul>
      <ContactChannels />
    </div>
    <div class="offer-split-block">
      <h2 class="offer-section-title">{offer.processTitle}</h2>
      <ol class="offer-steps">
        {
          offer.process.map((item) => (
            <li class="offer-step">
              <span class="offer-step-num gold-text">{item.step}</span>
              <div>
                <h3 class="offer-step-title">{item.title}</h3>
                <p class="offer-step-text">{item.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="home-final-cta">
    <h2 class="home-final-title">{offer.ctaTitle}</h2>
    <p class="home-final-text">{offer.ctaText}</p>
    <a href="/kontakt" class="site-btn site-btn-primary">Porozmawiajmy</a>
  </section>
</Fragment>
