---
import { getContent, localePath, type Locale } from "../i18n";

interface Props {
  compact?: boolean;
  locale?: Locale;
}

const { compact = false, locale = "pl" } = Astro.props;
const { labels } = getContent(locale);
const homeHref = localePath(locale, "home");
---

<a
  href={homeHref}
  class:list={["brand-mark", { "is-compact": compact }]}
  aria-label={labels.brandAria}
>
  <span class="brand-mark-mono" aria-hidden="true">
    <span>W</span>
    <span class="brand-mark-vline"></span>
    <span>Z</span>
  </span>
  <span class="brand-mark-meta">
    <span class="brand-mark-name">Wojciech · Zudro</span>
    <span class="brand-mark-rule" aria-hidden="true"></span>
    <span class="brand-mark-tag">Büroservice</span>
  </span>
</a>

<script is:inline>
  (function () {
    var base = document.documentElement.getAttribute("data-app-base") || "/";
    var baseTrim = base.replace(/\/$/, "");
    var path = window.location.pathname;
    var enRoot = baseTrim ? baseTrim + "/en/" : "/en/";
    var plRoot = baseTrim ? baseTrim + "/" : "/";
    var isEn =
      path === enRoot ||
      path === enRoot.replace(/\/$/, "") ||
      path.indexOf(enRoot) === 0;
    var home = isEn ? enRoot : plRoot;
    document.querySelectorAll("a.brand-mark").forEach(function (anchor) {
      anchor.setAttribute("href", home);
    });
  })();
</script>
