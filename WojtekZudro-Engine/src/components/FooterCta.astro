---
interface Props {
  variant?: "default" | "strategy" | "technical" | "local";
  lead?: string;
}

const { variant = "default", lead } = Astro.props;

const CTA_BY_VARIANT = {
  default: {
    lead: "Masz pytania po lekturze?",
    tail: "Napisz na",
    tail2: "albo przejdź do",
    formLabel: "formularza kontaktowego",
  },
  strategy: {
    lead: "Chcesz plan SEO pod Twoją branżę i budżet?",
    tail: "Napisz na",
    tail2: "albo wyślij brief przez",
    formLabel: "formularz kontaktowy",
  },
  technical: {
    lead: "Chcesz techniczny audyt strony i listę priorytetów wdrożeniowych?",
    tail: "Napisz na",
    tail2: "albo przejdź do",
    formLabel: "formularza kontaktowego",
  },
  local: {
    lead: "Chcesz poprawić widoczność lokalną i wizytówkę Google?",
    tail: "Napisz na",
    tail2: "albo zostaw wiadomość w",
    formLabel: "formularzu kontaktowym",
  },
} as const;

const fallback = CTA_BY_VARIANT[variant];
const ctaLead = lead ?? fallback.lead;
const tail = lead
  ? { tail: "Napisz na", tail2: "albo wyślij brief przez", formLabel: "formularz kontaktowy" }
  : fallback;
---

<section class="site-footer-cta" aria-label="Kontakt i CTA">
  <p>
    {ctaLead} {tail.tail}
    <a class="gold-text" href="mailto:kontakt@wojciechzudro.pl">kontakt@wojciechzudro.pl</a>
    {" "}{tail.tail2}
    <a class="gold-text" href="/kontakt">{tail.formLabel}</a>.
  </p>
</section>
