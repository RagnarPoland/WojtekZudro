---
import BrandMark from "./BrandMark.astro";
import {
  getContent,
  getOfferMenuItems,
  localePath,
  serviceUrl,
  switchLocalePath,
  type Locale,
} from "../i18n";
import { withBase, withoutBase } from "../lib/site";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const { SITE_NAV, SITE_CTA, labels } = content;
const offerMenuItems = getOfferMenuItems(locale);
const currentPath = withoutBase(Astro.url.pathname);
const servicesHref = locale === "en" ? "/en/services" : "/uslugi";
const isOfferSection = currentPath.startsWith("/uslugi") || currentPath.startsWith("/en/services");
const switchToPl = switchLocalePath(Astro.url.pathname, "pl");
const switchToEn = switchLocalePath(Astro.url.pathname, "en");
---

<header class="site-header">
  <BrandMark compact locale={locale} />

  <div class="site-header-end">
    <div class="site-lang-dropdown" data-lang-dropdown>
      <button
        type="button"
        class="site-lang-trigger"
        aria-expanded="false"
        aria-controls="siteLangMenu"
        aria-haspopup="true"
        aria-label={labels.langTriggerAria}
      >
        {
          locale === "en" ? (
            <svg class="site-lang-flag" viewBox="0 0 190 100" aria-hidden="true">
              <rect width="190" height="100" fill="#B22234"></rect>
              <rect y="7.7" width="190" height="7.7" fill="#fff"></rect>
              <rect y="23.1" width="190" height="7.7" fill="#fff"></rect>
              <rect y="38.5" width="190" height="7.7" fill="#fff"></rect>
              <rect y="53.8" width="190" height="7.7" fill="#fff"></rect>
              <rect y="69.2" width="190" height="7.7" fill="#fff"></rect>
              <rect y="84.6" width="190" height="7.7" fill="#fff"></rect>
              <rect width="76" height="53.8" fill="#3C3B6E"></rect>
            </svg>
          ) : (
            <svg class="site-lang-flag site-lang-flag-pl" viewBox="0 0 3 2" aria-hidden="true">
              <rect width="3" height="1" fill="#fff"></rect>
              <rect y="1" width="3" height="1" fill="#DC143C"></rect>
            </svg>
          )
        }
        <span class="site-lang-chevron" aria-hidden="true"></span>
      </button>
      <div id="siteLangMenu" class="site-lang-panel" role="menu" aria-label={labels.langMenuAria}>
        {
          locale === "en" ? (
            <a href={switchToPl} class="site-lang-option site-lang-option-link" role="menuitem" title="Polski" aria-label="Polski">
              <svg class="site-lang-flag site-lang-flag-pl" viewBox="0 0 3 2" aria-hidden="true">
                <rect width="3" height="1" fill="#fff"></rect>
                <rect y="1" width="3" height="1" fill="#DC143C"></rect>
              </svg>
            </a>
          ) : (
            <a href={switchToEn} class="site-lang-option site-lang-option-link" role="menuitem" title="English" aria-label="English">
              <svg class="site-lang-flag" viewBox="0 0 190 100" aria-hidden="true">
                <rect width="190" height="100" fill="#B22234"></rect>
                <rect y="7.7" width="190" height="7.7" fill="#fff"></rect>
                <rect y="23.1" width="190" height="7.7" fill="#fff"></rect>
                <rect y="38.5" width="190" height="7.7" fill="#fff"></rect>
                <rect y="53.8" width="190" height="7.7" fill="#fff"></rect>
                <rect y="69.2" width="190" height="7.7" fill="#fff"></rect>
                <rect y="84.6" width="190" height="7.7" fill="#fff"></rect>
                <rect width="76" height="53.8" fill="#3C3B6E"></rect>
              </svg>
            </a>
          )
        }
        <button type="button" class="site-lang-option" role="menuitem" title={labels.langDeutschSoon} aria-label={labels.langDeutschSoon}>
          <svg class="site-lang-flag" viewBox="0 0 3 2" aria-hidden="true">
            <rect width="3" height="0.667" fill="#000"></rect>
            <rect y="0.667" width="3" height="0.667" fill="#D00"></rect>
            <rect y="1.333" width="3" height="0.667" fill="#FFCE00"></rect>
          </svg>
        </button>
        <button type="button" class="site-lang-option" role="menuitem" title={labels.langDutchSoon} aria-label={labels.langDutchSoon}>
          <svg class="site-lang-flag" viewBox="0 0 9 6" aria-hidden="true">
            <rect width="9" height="2" fill="#AE1C28"></rect>
            <rect y="2" width="9" height="2" fill="#fff"></rect>
            <rect y="4" width="9" height="2" fill="#21468B"></rect>
          </svg>
        </button>
      </div>
    </div>

    <button
      class="site-menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="sitePrimaryMenu"
      aria-label={labels.menuOpen}
      data-menu-open={labels.menuOpen}
      data-menu-close={labels.menuClose}
    >
      <span class="site-menu-toggle-line" aria-hidden="true"></span>
      <span class="site-menu-toggle-line" aria-hidden="true"></span>
      <span class="site-menu-toggle-line" aria-hidden="true"></span>
    </button>

    <nav class="site-nav" id="sitePrimaryMenu" aria-label={labels.mainNavAria}>
    {
      SITE_NAV.map((item) => {
        if (item.href === servicesHref) {
          return (
            <>
              <div
                class:list={["site-nav-offer-desktop", { "is-active": isOfferSection }]}
                data-offer-dropdown
              >
                <button
                  type="button"
                  class="site-nav-dropdown-trigger"
                  aria-expanded="false"
                  aria-controls="siteOfferDropdown"
                  aria-haspopup="true"
                >
                  <span class="site-nav-dropdown-label">{item.label}</span>
                  <span class="site-nav-dropdown-chevron" aria-hidden="true"></span>
                </button>
                <div class="site-nav-dropdown-hover-zone">
                  <div class="site-nav-dropdown-bridge" aria-hidden="true"></div>
                  <div id="siteOfferDropdown" class="site-nav-dropdown-panel">
                    <p class="site-nav-dropdown-lead">
                      {labels.offerDropdownLead}{" "}
                      <span class="gold-text">{labels.offerDropdownLeadHighlight}</span>
                      {labels.offerDropdownSuffix}
                    </p>
                    <div class="site-nav-dropdown-grid">
                      {
                        offerMenuItems.map((service) => (
                          <a
                            href={serviceUrl(locale, service.slug)}
                            class:list={[
                              "site-nav-dropdown-item",
                              {
                                "is-active":
                                  currentPath === `/uslugi/${service.slug}` ||
                                  currentPath === `/en/services/${service.slug}`,
                              },
                            ]}
                          >
                            <span class="site-nav-dropdown-item-title">{service.menuLabel}</span>
                            <span class="site-nav-dropdown-item-desc">{service.menuDescription}</span>
                          </a>
                        ))
                      }
                    </div>
                  </div>
                </div>
              </div>

              <div
                class:list={["site-nav-offer-mobile", { "is-active": isOfferSection }]}
                data-offer-accordion
              >
                <button
                  type="button"
                  class="site-nav-accordion-trigger"
                  aria-expanded="false"
                  aria-controls="siteOfferSubmenu"
                >
                  <span class="site-nav-accordion-dot" aria-hidden="true"></span>
                  <span class="site-nav-accordion-label gold-text">{item.label}</span>
                  <span class="site-nav-accordion-chevron" aria-hidden="true"></span>
                </button>
                <div id="siteOfferSubmenu" class="site-nav-submenu">
                  {
                    offerMenuItems.map((service) => (
                      <a
                        href={serviceUrl(locale, service.slug)}
                        class:list={[
                          "site-nav-submenu-link",
                          {
                            "is-active":
                              currentPath === `/uslugi/${service.slug}` ||
                              currentPath === `/en/services/${service.slug}`,
                          },
                        ]}
                      >
                        <span>{service.menuLabel}</span>
                        <span class="site-nav-submenu-arrow" aria-hidden="true">→</span>
                      </a>
                    ))
                  }
                </div>
              </div>
            </>
          );
        }

        return (
          <a
            href={withBase(item.href)}
            class:list={[
              "site-nav-link",
              {
                "gold-text": item.highlight,
                "is-active":
                  (currentPath === item.href || currentPath.startsWith(`${item.href}/`)) &&
                  item.href !== "/",
              },
            ]}
          >
            {item.label}
          </a>
        );
      })
    }
    <a href={localePath(locale, "contact")} class="site-nav-cta">{SITE_CTA.buttonMenu}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector(".site-header");
  const toggle = document.querySelector(".site-menu-toggle");
  const menu = document.querySelector("#sitePrimaryMenu");
  const offerAccordion = document.querySelector("[data-offer-accordion]");
  const offerTrigger = offerAccordion?.querySelector(".site-nav-accordion-trigger");
  const offerDropdown = document.querySelector("[data-offer-dropdown]");
  const dropdownTrigger = offerDropdown?.querySelector(".site-nav-dropdown-trigger");
  const langDropdown = document.querySelector("[data-lang-dropdown]");
  const langTrigger = langDropdown?.querySelector(".site-lang-trigger");

  if (header && toggle && menu) {
    const closeOfferAccordion = () => {
      offerAccordion?.classList.remove("is-expanded");
      offerTrigger?.setAttribute("aria-expanded", "false");
    };

    const closeOfferDropdown = () => {
      offerDropdown?.classList.remove("is-open");
      dropdownTrigger?.setAttribute("aria-expanded", "false");
    };

    const closeLangDropdown = () => {
      langDropdown?.classList.remove("is-open");
      langTrigger?.setAttribute("aria-expanded", "false");
    };

    const closeMenu = () => {
      header.classList.remove("menu-open");
      toggle.setAttribute("aria-expanded", "false");
      toggle.setAttribute(
        "aria-label",
        toggle.dataset.menuOpen ?? "Open navigation menu",
      );
      closeOfferAccordion();
      closeOfferDropdown();
      closeLangDropdown();
    };

    toggle.addEventListener("click", () => {
      const isOpen = header.classList.contains("menu-open");
      if (isOpen) closeMenu();
      else {
        closeOfferDropdown();
        closeLangDropdown();
        header.classList.add("menu-open");
        toggle.setAttribute("aria-expanded", "true");
        toggle.setAttribute(
          "aria-label",
          toggle.dataset.menuClose ?? "Close navigation menu",
        );
      }
    });

    offerTrigger?.addEventListener("click", () => {
      const isExpanded = offerAccordion?.classList.toggle("is-expanded") ?? false;
      offerTrigger.setAttribute("aria-expanded", isExpanded ? "true" : "false");
    });

    dropdownTrigger?.addEventListener("click", (event) => {
      event.stopPropagation();
      closeLangDropdown();
      const isOpen = offerDropdown?.classList.toggle("is-open") ?? false;
      dropdownTrigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });

    langTrigger?.addEventListener("click", (event) => {
      event.stopPropagation();
      closeOfferDropdown();
      const isOpen = langDropdown?.classList.toggle("is-open") ?? false;
      langTrigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
    });

    langDropdown?.querySelectorAll(".site-lang-option").forEach((option) => {
      option.addEventListener("click", () => closeLangDropdown());
    });

    offerDropdown?.querySelectorAll(".site-nav-dropdown-item").forEach((link) => {
      link.addEventListener("click", closeOfferDropdown);
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (offerDropdown && !offerDropdown.contains(target)) {
        closeOfferDropdown();
      }
      if (langDropdown && !langDropdown.contains(target)) {
        closeLangDropdown();
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeMenu();
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 1024) closeMenu();
      else {
        closeOfferDropdown();
        closeLangDropdown();
      }
    });
  }
</script>
