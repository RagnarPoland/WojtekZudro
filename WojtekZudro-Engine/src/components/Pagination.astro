---
import { BLOG_BASE } from "../lib/blog";

interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

function pageHref(page: number): string {
  if (page <= 1) return `${BLOG_BASE}/`;
  return `${BLOG_BASE}/page/${page}/`;
}
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Paginacja bloga">
      <a
        class:list={["pagination-link", { disabled: currentPage <= 1 }]}
        href={currentPage > 1 ? pageHref(currentPage - 1) : undefined}
      >
        Poprzednia
      </a>
      <p class="pagination-state">
        Strona {currentPage} z {totalPages}
      </p>
      <a
        class:list={["pagination-link", { disabled: currentPage >= totalPages }]}
        href={currentPage < totalPages ? pageHref(currentPage + 1) : undefined}
      >
        Następna
      </a>
    </nav>
  )
}
